<?xml version="1.0" encoding="UTF-8"?>
<!--
  grass_ground_big - trawiaste pole 400 x 400 m.

  Powiekszona wersja grass_ground (tam bylo 100 x 100 m, czyli przy ortofoto nad
  polem 150 x 250 m kamera patrzylaby glownie w szare tlo).

  Kolizja to plaszczyzna, czyli w gz-physics nieskonczona polprzestrzen -
  rozmiar dotyczy WYLACZNIE wizualizacji.

  Kafle maja 20 m zamiast 10 m jak w oryginale: 400 wizualizacji zamiast
  1600. Tekstura jest przez to rozciagnieta 2x, co z wysokosci
  lotu jest nie do odroznienia, a RTF symulacji jest tu waskim gardlem.
-->
<sdf version="1.9">
  <model name="grass_ground_big">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <geometry>
          <plane>
            <normal>0 0 1</normal>
            <size>400 400</size>
          </plane>
        </geometry>
      </collision>
      <!-- Siatka kafli 20x20 m -->
      <visual name="tile_0_0"><pose>-190 -190 0 0 0 0</pose><cast_shadows>false</cast_shadows><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry><material><diffuse>1 1 1 1</diffuse><ambient>1 1 1 1</ambient><pbr><metal><albedo_map>materials/textures/grass_dry.png</albedo_map></metal></pbr></material></visual>
      <visual name="tile_1_0"><pose>-170 -190 0 0 0 0</pose><cast_shadows>false</cast_shadows><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry><material><diffuse>1 1 1 1</diffuse><ambient>1 1 1 1</ambient><pbr><metal><albedo_map>materials/textures/grass_dry.png</albedo_map></metal></pbr></material></visual>
