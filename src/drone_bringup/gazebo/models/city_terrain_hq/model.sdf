<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="city_terrain_hq">
    <static>true</static>
    <link name="link">
      <pose>0 0 -5 0 0 0</pose>

      <collision name="collision">
        <geometry>
          <heightmap>
            <uri>model://city_terrain_hq/materials/textures/city_terrain.jpg</uri>
            <size>500 500 75</size>
            <pos>40 -20 -5</pos>
          </heightmap>
        </geometry>
      </collision>

      <visual name="visual">
        <geometry>
          <heightmap>
            <use_terrain_paging>false</use_terrain_paging>

            <!-- Base dry grass layer -->
            <texture>
              <diffuse>model://city_terrain_hq/materials/textures/grass_dry.png</diffuse>
              <normal>model://city_terrain_hq/materials/textures/normals.dds</normal>
              <size>36</size>
            </texture>
            <blend>
              <min_height>0.0</min_height>
              <fade_dist>2.5</fade_dist>
            </blend>

            <!-- Mid layer: sandy / bare patches -->
            <texture>
              <diffuse>model://city_terrain_hq/materials/textures/soil_sand_0045_01.jpg</diffuse>
              <normal>model://city_terrain_hq/materials/textures/normals.dds</normal>
              <size>22</size>
            </texture>
            <blend>
              <min_height>4.0</min_height>
              <fade_dist>10.0</fade_dist>
            </blend>

            <!-- Higher areas: greener vegetation -->
            <texture>
              <diffuse>model://city_terrain_hq/materials/textures/forest.jpg</diffuse>
              <normal>model://city_terrain_hq/materials/textures/normals.dds</normal>
              <size>52</size>
            </texture>

            <uri>model://city_terrain_hq/materials/textures/city_terrain.jpg</uri>
            <size>500 500 75</size>
            <pos>40 -20 -5</pos>
          </heightmap>
        </geometry>
      </visual>
    </link>
  </model>
</sdf>
