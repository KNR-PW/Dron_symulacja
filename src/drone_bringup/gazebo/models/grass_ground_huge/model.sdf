<?xml version="1.0" encoding="UTF-8"?>
<!--
  grass_ground_huge - trawiaste pole 800 x 800 m.

  Powiekszona wersja grass_ground_big (400 x 400 m). Powod: trasa ortofoto
  i siatka przeszukiwania nie sa wysrodkowane na punkcie startu drona, wiec
  przy 400 m dron wylatywal poza teksture i patrzyl w szare tlo.

  Kolizja to plaszczyzna, czyli w gz-physics nieskonczona polprzestrzen -
  rozmiar dotyczy WYLACZNIE wizualizacji.

  Kafle maja 40 m zamiast 20 m jak w grass_ground_big: dwa razy wiekszy teren
  kosztuje TYLE SAMO co poprzednio, bo wizualizacji jest dalej 400. Tekstura
  jest przez to rozciagnieta 4x wzgledem oryginalu, co z pulapu 50-80 m jest
  nie do odroznienia, a waskim gardlem symulacji jest RTF, nie ostrosc trawy.
-->
<sdf version="1.9">
  <model name="grass_ground_huge">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <geometry>
          <plane>
            <normal>0 0 1</normal>
            <size>800 800</size>
          </plane>
        </geometry>
      </collision>
      <!-- Siatka kafli 40x40 m -->
      <visual name="tile_0_0"><pose>-380 -380 0 0 0 0</pose><cast_shadows>false</cast_shadows><geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry><material><diffuse>1 1 1 1</diffuse><ambient>1 1 1 1</ambient><pbr><metal><albedo_map>materials/textures/grass_dry.png</albedo_map></metal></pbr></material></visual>
      <visual name="tile_1_0"><pose>-340 -380 0 0 0 0</pose><cast_shadows>false</cast_shadows><geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry><material><diffuse>1 1 1 1</diffuse><ambient>1 1 1 1</ambient><pbr><metal><albedo_map>materials/textures/grass_dry.png</albedo_map></metal></pbr></material></visual>
